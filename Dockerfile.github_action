# Dockerfile for PR Genius GitHub Action
# Optimized for GitHub Actions environment

FROM python:3.12-slim

LABEL maintainer="zsxh1990 <445655361@qq.com>"
LABEL project="pr-genius"
LABEL description="PR Genius GitHub Action - Evidence-backed PR contribution advisor"
LABEL license="MIT"

# Install git (required for PR Genius)
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install prgenius-core from PyPI
RUN pip install --no-cache-dir prgenius-core

# Copy knowledge bundle data
COPY anti-patterns/ ./anti-patterns/
COPY success-patterns/ ./success-patterns/
COPY docs/ ./docs/
COPY index.md validate.py ./
COPY *.md ./*.md ./ 2>/dev/null || true

# Copy entrypoint
COPY github_action/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Health check
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python3 -m prgenius --version || exit 1

ENTRYPOINT ["/entrypoint.sh"]
